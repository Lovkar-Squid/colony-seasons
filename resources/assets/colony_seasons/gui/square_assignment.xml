<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="190 244">
    <!-- The Town Square's Decorator page: MineColonies' quarry assignment layout (layoutminerassignment.xml) with our text. -->
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text size="164 11" pos="13 32" textalign="MIDDLE" color="black"
           label="$(com.minecolonies.coremod.gui.workerhuts.workerassigned)"/>

    <list id="workers" size="164 30" pos="13 43">
        <view size="100% 11">
            <box size="100% 11" linewidth="0">
                <text id="workerName" size="100% 11" pos="0 0" textalign="MIDDLE" color="black"/>
            </box>
        </view>
    </list>

    <button id="hire" size="129 17" pos="30 74" color="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.manage)"/>
    <button id="recall" size="129 17" pos="30 92" color="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.recall)"/>
    <text id="text" size="150 36" pos="30 114" color="black" text="$(com.colony_seasons.gui.square.decorator.desc)"/>
    <!-- which square is the colony's main one (Q5); the window fills it in from the page's packet -->
    <text id="main" size="150 54" pos="30 154" color="black"/>
</window>
